# Add your existing self-hosted gateway credentials here (server side only).
# OmniRoute public OpenAI-compatible endpoint.
# Use the local endpoint only when this app's backend runs on the same host.
AI_GATEWAY_URL=https://omnirote67hb7b78g.duckdns.org/v1
AI_GATEWAY_API_KEY=your_existing_gateway_key_here

# These are the three model IDs currently allowed by the restricted OmniRoute API key.
# Keep these server-side in .env.local or your host's environment-variable settings.
# Verified in this OmniRoute catalog (vision-capable, currently provider-degraded).
AI_MODEL_GEMINI=gemini/gemini-2.5-flash
AI_MODEL_CLAUDE=kiro/claude-sonnet-4.5-high
AI_MODEL_DEEPSEEK=dva/deepseek-v4-flash-high
